rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Administradores autorizados: leitura permitida para autenticar login; gravação bloqueada no cliente
    // (Apenas o proprietário adiciona ou remove administradores diretamente pelo Console do Firebase)
    match /administradores/{adminDoc} {
      allow read: if true;
      allow write: if false;
    }

    // Perfil público: qualquer visitante pode ler; gravação permitida para atualizar dados do perfil
    match /perfis/{perfilId} {
      allow read: if true;
      allow write: if true;
    }

    // Métricas de cliques: visitantes podem criar registros de cliques; leitura permitida; exclusão/alteração bloqueada
    match /cliques/{cliqueId} {
      allow create: if true;
      allow read: if true;
      allow update, delete: if false;
    }

    // Métricas de visualizações: criação e leitura permitidas; proteção contra exclusão ou adulteração
    match /visualizacoes/{visId} {
      allow create: if true;
      allow read: if true;
      allow update, delete: if false;
    }

    // Chunks de mídias pesadas (vídeos e fotos de alta resolução particionados)
    match /media_chunks/{chunkId} {
      allow read, write: if true;
    }

    // Regra padrão de fallback: bloqueia gravações em coleções não declaradas
    match /{document=**} {
      allow read: if true;
      allow write: if false;
    }
  }
}
